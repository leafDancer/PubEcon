# Build context is the repository root.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PUBECON_DB=/data/top5.db

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir ".[api]" \
    && useradd --create-home --uid 10001 pubecon

USER pubecon

EXPOSE 8000

CMD ["uvicorn", "econpub.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
